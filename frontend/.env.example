VITE_API_BASE_URL=http://localhost:5158

# Map tiles for activity routes (build-time). Empty = OpenStreetMap's own servers — fine for
# development, but their usage policy forbids heavier traffic. Production example (MapTiler,
# free tier with a key; dark style, so no CSS inversion):
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY
#   VITE_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
#   VITE_MAP_TILES_DARK=true
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILES_DARK=
