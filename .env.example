# Copy to .env and fill in real values. NEVER commit the real .env file.

# --- PostgreSQL ---
POSTGRES_DB=traincoach
POSTGRES_USER=traincoach
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- Backend / JWT ---
# Generate a real secret, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=change_me_to_a_random_secret_at_least_32_characters_long
JWT_ISSUER=TrainCoach
JWT_AUDIENCE=TrainCoach.Clients
ASPNETCORE_ENVIRONMENT=Production

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend ---
# Must be reachable from the *browser*, not just from inside the docker network.
VITE_API_BASE_URL=http://localhost:5158

# --- Strava integration (optional) ---
# Create an API application at https://www.strava.com/settings/api (see
# docs/integrations-research.md for the verified setup steps) to activate real Strava sync.
# Leave blank to keep Strava in its "not connected" state — everything else in the app works
# without these.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5173/integrations/strava/callback

# --- intervals.icu integration (optional) ---
# Register an OAuth app at https://intervals.icu/settings (Developer Settings) — see
# docs/integrations-research.md §5 for the verified setup steps. intervals.icu itself aggregates
# Garmin/Polar/Suunto/Coros/Huawei/Amazfit/Oura/WHOOP/Strava, so this is the preferred way to reach
# real Garmin/wellness data (sleep, HRV, resting HR, readiness, stress) without Garmin's own
# business-only Connect Developer Program approval.
# Leave blank to keep intervals.icu in its "not connected" state — everything else in the app
# works without these.
INTERVALS_ICU_CLIENT_ID=
INTERVALS_ICU_CLIENT_SECRET=
INTERVALS_ICU_REDIRECT_URI=http://localhost:5173/integrations/intervals-icu/callback

# --- Oura / WHOOP integrations (not yet available) ---
# Architecture-ready only — no real developer credentials exist for this project yet. See
# docs/integrations/oura-whoop-activation.md for exactly how to activate once they do. Leave
# blank; every Oura/WHOOP call throws a clear "not configured" error until these are filled in.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:5173/integrations/oura/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:5173/integrations/whoop/callback

# --- Activity matching (deduplication) ---
# Confidence thresholds for auto-merging vs. flagging vs. treating as separate activities across
# sources — see docs/integrations/activity-matching.md.
ACTIVITY_MATCHING_AUTO_MERGE_THRESHOLD=85
ACTIVITY_MATCHING_MANUAL_REVIEW_THRESHOLD=60

# Map tiles for activity routes (build-time). Empty = OpenStreetMap's own servers — fine for
# development, but their usage policy forbids heavier traffic. Production example (MapTiler,
# free tier with a key; dark style, so no CSS inversion):
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY
#   VITE_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
#   VITE_MAP_TILES_DARK=true
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILES_DARK=
